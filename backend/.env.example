# Sunucu
PORT=
CLIENT_ORIGIN=

# Uretimde "production" yapin: oturum cerezine Secure bayragi eklenir,
# yani cerez yalnizca HTTPS uzerinden gonderilir.
NODE_ENV=development

# JWT
# Uretimde uzun ve rastgele olmali. Uretmek icin:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# PostgreSQL
DB_USER=
DB_HOST=
DB_DATABASE=
DB_PASSWORD=
DB_PORT=
