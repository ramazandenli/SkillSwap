generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventStatus {
  waiting
  accepted
  completed
  cancelled
  rejected

  @@map("event_status")
}

enum EventType {
  exchange
  teach

  @@map("event_type")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique @db.VarChar(30)
  email        String   @unique
  name         String   @db.VarChar(30)
  surname      String   @db.VarChar(30)
  gender       String?  @db.Char(1)
  birthdate    DateTime @db.Date
  passwordHash String   @map("password_hash")
  avatarUrl    String?  @map("avatar_url")
  bio          String?
  points       Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  hasSkills    UserSkill[] @relation("UserHasSkills")
  needsSkills  UserSkill[] @relation("UserNeedsSkills")
  followers    Follow[]    @relation("Followed")
  following    Follow[]    @relation("Follower")
  sentTexts    Message[]   @relation("FromUser")
  recvTexts    Message[]   @relation("ToUser")
  eventsAsA    Event[]     @relation("EventUserA")
  eventsAsB    Event[]     @relation("EventUserB")
  reviewsGiven Review[]    @relation("ReviewFrom")
  reviewsRecv  Review[]    @relation("ReviewTo")

  @@index([points])
  @@map("users")
}

model Skill {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(120)
  category  String?  @db.VarChar(60)
  createdAt DateTime @default(now()) @map("created_at")

  userSkills UserSkill[]
  eventsA    Event[]     @relation("EventSkillA")
  eventsB    Event[]     @relation("EventSkillB")

  @@map("skills")
}

enum UserSkillKind {
  has
  needs

  @@map("user_skill_kind")
}

model UserSkill {
  userId  String        @map("user_id")
  skillId Int           @map("skill_id")
  kind    UserSkillKind
  level   Int?

  userHas    User? @relation("UserHasSkills", fields: [userId], references: [id], onDelete: Cascade, map: "userskill_user_has_fk")
  userNeeds  User? @relation("UserNeedsSkills", fields: [userId], references: [id], onDelete: Cascade, map: "userskill_user_needs_fk")
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId, kind])
  @@index([skillId, kind])
  @@map("user_skills")
}

model Follow {
  followerId String @map("follower_id")
  followedId String @map("followed_id")
  createdAt  DateTime @default(now()) @map("created_at")

  follower User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followed User @relation("Followed", fields: [followedId], references: [id], onDelete: Cascade)

  @@id([followerId, followedId])
  @@index([followedId])
  @@map("follows")
}

model Message {
  id        String   @id @default(cuid())
  fromId    String   @map("from_id")
  toId      String   @map("to_id")
  body      String
  readAt    DateTime? @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")

  from User @relation("FromUser", fields: [fromId], references: [id], onDelete: Cascade)
  to   User @relation("ToUser", fields: [toId], references: [id], onDelete: Cascade)

  @@index([fromId, toId, createdAt])
  @@map("messages")
}

model Event {
  id        String      @id @default(cuid())
  user1Id   String      @map("user1_id")
  skill1Id  Int         @map("skill1_id")
  user2Id   String      @map("user2_id")
  skill2Id  Int         @map("skill2_id")
  startDate DateTime    @map("start_date") @db.Date
  endDate   DateTime    @map("end_date") @db.Date
  status    EventStatus @default(waiting)
  type      EventType
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  user1  User    @relation("EventUserA", fields: [user1Id], references: [id], onDelete: Cascade)
  user2  User    @relation("EventUserB", fields: [user2Id], references: [id], onDelete: Cascade)
  skill1 Skill   @relation("EventSkillA", fields: [skill1Id], references: [id], onDelete: Cascade)
  skill2 Skill   @relation("EventSkillB", fields: [skill2Id], references: [id], onDelete: Cascade)
  reviews Review[]

  @@index([user1Id, status])
  @@index([user2Id, status])
  @@map("events")
}

model Review {
  id        String   @id @default(cuid())
  eventId   String   @map("event_id")
  fromId    String   @map("from_id")
  toId      String   @map("to_id")
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  from  User  @relation("ReviewFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to    User  @relation("ReviewTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([eventId, fromId])
  @@index([toId])
  @@map("reviews")
}
